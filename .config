# Website Metadata Hunter settings. One "key = value" per line; # starts a comment.

# exiftool_path: optional path to ExifTool (https://exiftool.org).
#   When it points to a working ExifTool 12.24 or newer, ExifTool reads the regular
#   metadata tags and the built-in parsers add what ExifTool does not report
#   (reviewer names inside documents, PDF revisions, appended data, leaked paths...).
#   Leave it empty, or point it somewhere invalid, and only the built-in parsers are used.
#   Accepted forms: absolute or relative (to this folder), / or \ separators, a folder
#   that contains exiftool / exiftool.exe, ~ for your home folder, $VAR or %VAR%.
#   Examples:  exiftool_path = C:\Tools\exiftool.exe
#              exiftool_path = ./tools/exiftool
#              exiftool_path = /usr/bin/exiftool
exiftool_path = C:\Users\cagan\Desktop\Apps\exiftool-13.59_64\exiftool-13.59_64\exiftool.exe
